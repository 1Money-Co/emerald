# syntax=docker/dockerfile:1

FROM rust:1.91.1-bookworm AS builder

WORKDIR /build

RUN apt-get update -qq && \
    apt-get install -yqq --no-install-recommends \
      build-essential \
      clang \
      cmake \
      libclang-dev && \
    rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN cargo build --release --locked --bin custom-reth

FROM debian:bookworm-slim AS runtime

RUN apt-get update -qq && \
    apt-get install -yqq --no-install-recommends \
      ca-certificates \
      curl \
      jq \
      libssl3 \
      procps && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/conf /app/data /app/logs

WORKDIR /app

COPY --from=builder /build/target/release/custom-reth /usr/local/bin/custom-reth

ENTRYPOINT ["/usr/local/bin/custom-reth"]
